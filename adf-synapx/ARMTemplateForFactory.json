												},
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "LS_FHIR_AZSQL",
										"type": "LinkedServiceReference"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-11-08T10:05:05Z"
