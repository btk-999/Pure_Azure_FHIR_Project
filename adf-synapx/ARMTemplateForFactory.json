												"relative_url": {
													"value": "@concat(item(), '?_lastUpdated=ge',\nuriComponent(activity('wtrmrk_col_fetch').output.firstRow.LastWatermark))\n",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_Synapx_Bronze_Json",
