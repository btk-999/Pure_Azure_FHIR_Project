											"referenceName": "PL_ADLS_Bronze_To_SQL_Stg",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"ResourceType": {
												"value": "@item()",
												"type": "Expression"
											},
											"Directory": {
												"value": "@concat(item(),'/year=',formatDateTime(utcNow(),'yyyy'),\n'/month=',formatDateTime(utcNow(),'MM'),\n'/day=',formatDateTime(utcNow(),'dd'))",
												"type": "Expression"
											},
