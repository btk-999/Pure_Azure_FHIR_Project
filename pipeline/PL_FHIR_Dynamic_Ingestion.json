{
	"name": "PL_FHIR_Dynamic_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "FHIR_Foreach_Iteration",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@createArray(\n    'Patient',\n    'Encounter',\n    'Observation',\n    'Condition'\n)",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Iteration_copy_data",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "wtrmrk_col_fetch",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"AbsoluteUrl": "$.$.link[?(@.relation=='next')].url"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_fhir_API",
									"type": "DatasetReference",
									"parameters": {
										"relative_url": {
											"value": "@concat(item(), '?_lastUpdated=ge',\nuriComponent(activity('wtrmrk_col_fetch').output.firstRow.LastWatermark))\n",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Synapx_Bronze_Json",
									"type": "DatasetReference",
									"parameters": {
										"directory": {
											"value": "@concat(item(),'/year=',formatDateTime(utcNow(),'yyyy'),\n'/month=',formatDateTime(utcNow(),'MM'),\n'/day=',formatDateTime(utcNow(),'dd'))",
											"type": "Expression"
										},
										"file_name": {
											"value": "@concat(item(),'_',pipeline().RunId,'.json')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Execute Pipeline1",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Iteration_copy_data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_ADLS_Bronze_To_SQL_Stg",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"ResourceType": {
										"value": "@item()",
										"type": "Expression"
									},
									"Directory": {
										"value": "@concat(item(),'/year=',formatDateTime(utcNow(),'yyyy'),\n'/month=',formatDateTime(utcNow(),'MM'),\n'/day=',formatDateTime(utcNow(),'dd'))",
										"type": "Expression"
									},
									"ApiUrlOrParamsFileName": {
										"value": "@concat('https://hapi.fhir.org/baseR4/', item())",
										"type": "Expression"
									},
									"FileName": {
										"value": "@concat(item(),'_',pipeline().RunId,'.json')",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "wtrmrk_col_fetch",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT ResourceType, CONVERT(VARCHAR(19), LastWatermark, 126) + 'Z' AS LastWatermark\nFROM dbo.Fhir_Watermark WHERE ResourceType = '@{item()}';",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_SQL_FHIR_RAW",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "wtrmrk_upd_procedure",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Execute Pipeline1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[usp_UpdateFHIRWatermark]",
								"storedProcedureParameters": {
									"ResourceType": {
										"value": {
											"value": "@item()",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_FHIR_AZSQL",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-11-08T10:05:05Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}